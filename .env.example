# Client sign-in (/demo/sign-in). Copy to .env.local for local testing, and add the same in Vercel's settings.
# Accounts: username:password:Display name, several separated by ";". Use long, random passwords.
TYODE_CLIENTS="yokohama:change-this-to-a-long-password:Yokohama TWS Lanka"
# Any long random string (32+ characters). Changing it signs every client out.
TYODE_SESSION_SECRET="change-this-to-a-long-random-string-of-32-or-more-characters"
